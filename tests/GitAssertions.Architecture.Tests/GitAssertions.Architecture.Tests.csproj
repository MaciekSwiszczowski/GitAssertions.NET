<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rules about this repository, not tests of the library: today the library's checks run on this repository itself
    (ThisRepositoryTests). Only a person changes or weakens a rule here (AGENTS.md, The repository's own tests are a
    ratchet).

    It is a test project of its own because libgit2's settings are process-wide. GitAssertions.Tests cuts libgit2 off
    from the machine's git config (LibGit2Isolation), so its TempRepo scenarios repeat on every machine. A check of a
    real repository needs the opposite: the config that `git status` reads, such as core.autocrlf, or a CRLF file
    saved unchanged reads as modified. This project does not isolate, so it sees what `git status` and a user's own
    test project see. A future rule that needs isolation goes into GitAssertions.Tests.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit1069: see GitAssertions.Tests.csproj. -->
    <NoWarn>$(NoWarn);xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitAssertions\GitAssertions.csproj" />
  </ItemGroup>

  <!--
    The snapshot helper and the timeout are shared with GitAssertions.Tests, not copied. GitAnswer is a type of the
    helper's script overload, which this project does not call but the helper's source needs to compile. LineBreak is
    the library's own internal class, linked as source because this project sees only the public API, like a user's
    own test project, and the helper writes its snapshots with LineBreak.Lf.
  -->
  <ItemGroup>
    <Compile Include="..\GitAssertions.Tests\Infrastructure\CheckResultSnapshot.cs"
             Link="Shared\CheckResultSnapshot.cs" />
    <Compile Include="..\GitAssertions.Tests\Infrastructure\GitAnswer.cs" Link="Shared\GitAnswer.cs" />
    <Compile Include="..\GitAssertions.Tests\TestTimeouts.cs" Link="Shared\TestTimeouts.cs" />
    <Compile Include="..\..\src\GitAssertions\LineBreak.cs" Link="Shared\LineBreak.cs" />
  </ItemGroup>

  <!-- The root of the repository these tests are built from, for every rule in this project. -->
  <PropertyGroup>
    <ThisRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../..'))</ThisRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(ThisRepositoryRoot)" />
  </ItemGroup>

</Project>
