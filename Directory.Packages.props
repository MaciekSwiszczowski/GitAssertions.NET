<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Take the latest version when you add a package (`dotnet add package <name>` resolves and records it) rather
    than copying a number from another repository.
  -->
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Kept beside Microsoft.Testing.Platform for IDE test discovery. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>
  <!--
    Referenced only under the Debug_Analyzers configuration - see Directory.Build.props. Debug stays fast and
    runs no analyzers at all.
  -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- ErrorProne.NET has shipped only prereleases since 2018, so "latest" is a beta by necessity. -->
    <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
  </ItemGroup>
</Project>
