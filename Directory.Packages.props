<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Take the latest version when you add a package (`dotnet add package <name>` resolves and records it) rather
    than copying a number from another repository.
  -->
  <ItemGroup Label="Git">
    <!-- The library's only runtime dependency (from T2.1); the tests also use it directly to set up scenarios. -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Kept beside Microsoft.Testing.Platform for IDE test discovery. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- The assertion library for value tests: a failure prints the expected and the actual value. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!--
      Snapshot tests: every check scenario pins its whole CheckResult in a reviewed .verified.txt file.
      Pinned to the last free version, an exception to "take the latest". The next version is not free: Verify's Open
      Source Maintenance Fee covers every version released after 2026-09-01, 32.0.1 onwards, and from 33.0 the build
      fails (SponsorCheck SC021) until the project declares its fee status. The square brackets make the version
      exact, so no automatic update moves it, and .github/dependabot.yml ignores the package, so no PR proposes the
      next one. https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
    -->
    <PackageVersion Include="Verify.XunitV3" Version="[32.0.0]" />
    <!-- A disposable temp folder whose delete handles read-only files and links; used by the TempRepo test fixture. -->
    <PackageVersion Include="Meziantou.Framework.TemporaryDirectory" Version="3.0.17" />
    <!-- Runs the git CLI in the integration tests (T5.1): tree kill on cancel, and both output pipes read together. -->
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <!-- Reads the workflows in WorkflowPinTests (T7.11), so only real `uses:` keys are checked, whatever the quoting. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <!--
    Referenced only under the Debug_Analyzers and Release_Analyzers configurations - see Directory.Build.props.
    Debug stays fast and runs no analyzers at all.
  -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!-- ErrorProne.NET has shipped only prereleases since 2018, so "latest" is a beta by necessity. -->
    <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
  </ItemGroup>
</Project>