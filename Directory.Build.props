<Project>
  <!--
    Four configurations, and the difference between them is the point:

      Debug               as fast as possible. No analyzers, no NuGet audit. This is what you build while working.
      Debug_Analyzers     the full analyzer set, warnings as errors. A task is not done until this builds clean.
      Release             optimised output. Audit on, analyzers off. What a package is packed from.
      Release_Analyzers   Release's optimised output with Debug_Analyzers' analyzer set. The CI gate, so the tests
                          run against code compiled as the package ships it, and the analyzers run in the same build.

    The two *_Analyzers configurations share every analyzer setting through AnalyzersBuild, so they cannot drift
    apart: they differ only in optimisation and in the DEBUG constant.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Debug_Analyzers;Release;Release_Analyzers</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug_Analyzers' or '$(Configuration)' == 'Release_Analyzers'">
    <AnalyzersBuild>true</AnalyzersBuild>
  </PropertyGroup>

  <!--
    The analyzer packages below are referenced only under the *_Analyzers configurations, but project.assets.json is
    written once per restore and is not per-configuration. Building Debug straight after Debug_Analyzers without a
    restore - which is what an IDE does when it thinks packages are current - would therefore load those analyzers
    into the Debug build, where TreatWarningsAsErrors turns every hit into an error. Skipping analyzer execution
    outside them makes that leak harmless. Source generators are unaffected: this stops diagnostic analyzers
    only.
  -->
  <PropertyGroup Condition="'$(AnalyzersBuild)' != 'true'">
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <!-- Auditing is reserved for every configuration but Debug, to keep the Debug restore fast. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!--
    The test tier is partly exempt. The full CA / Meziantou / Roslynator ruleset stays off on test code: it is
    mostly false positives there (CA1707 alone fires on every underscored test method name). Off for the same
    reason are the two VS-Threading rules written for library code - VSTHRD111 (ConfigureAwait everywhere) and
    VSTHRD200 (Async suffix).

    What stays on, escalated to errors, is the set that catches a real bug in a fixture: nullable, CS1998 / CS4014,
    AsyncFixer, async void (VSTHRD100), unobserved async results (VSTHRD110), IDE0005 for unused usings and
    IDE2000 for stray blank lines.

    The IDisposable analyzers are deliberately absent from the test tier: on test code they are mostly false
    positives - a fixture built one helper call away, a disposable owned by a using in the caller.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != ''">
    <IsTestTierProject Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">true</IsTestTierProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug_Analyzers'">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE;DEBUG_ANALYZERS</DefineConstants>
  </PropertyGroup>

  <!-- The SDK optimises only a configuration named Release, so Release_Analyzers asks for Release's settings itself. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release_Analyzers'">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);RELEASE;TRACE;RELEASE_ANALYZERS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AnalyzersBuild)' == 'true' and '$(IsTestTierProject)' == 'true'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: a public test method per xUnit convention has no doc comment and never will. -->
    <NoWarn>$(NoWarn);CS1591;VSTHRD111;VSTHRD200</NoWarn>
    <WarningsAsErrors>
      nullable;CS1998;CS4014;
      AsyncFixer01;AsyncFixer02;AsyncFixer03;
      VSTHRD100;VSTHRD110;
      IDE0005;IDE2000
    </WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(AnalyzersBuild)' == 'true' and '$(IsTestTierProject)' == 'true'">
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <PackageReference Include="AsyncFixer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The library is consumed by other people's test projects, which may run under a SynchronizationContext, so
    ConfigureAwait (CA2007) stays on here, unlike in a console app.
  -->
  <PropertyGroup Condition="'$(AnalyzersBuild)' == 'true' and '$(IsTestTierProject)' != 'true'">
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>
      CA2007;CA2012;CA2016;CA1849;
      VSTHRD100;VSTHRD103;VSTHRD110;VSTHRD200;
      MA0040;MA0041;MA0134;
      AsyncFixer01;AsyncFixer02;AsyncFixer03;
      CS1998;
      IDISP001;IDISP003;IDISP004;IDISP007
    </WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(AnalyzersBuild)' == 'true' and '$(IsTestTierProject)' != 'true'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="IDisposableAnalyzers" PrivateAssets="all" />
    <PackageReference Include="AsyncFixer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    xUnit v3 test projects are self-hosting Microsoft.Testing.Platform executables, not VSTest libraries, so they
    must produce an apphost. `dotnet test` is routed through MTP by the "test.runner" entry in global.json.
  -->
  <PropertyGroup Condition="'$(IsTestTierProject)' == 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
</Project>
